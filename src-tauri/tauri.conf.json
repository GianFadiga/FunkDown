{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FunkDown",
  "version": "2.0.0",
  "identifier": "com.gianfadiga.funkdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FunkDown",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 580,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "category": "Utility",
    "shortDescription": "Baixe músicas e vídeos do YouTube, Instagram, TikTok e Facebook.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/GianFadiga/FunkDown/releases/latest/download/latest.json"],
      "pubkey": "SUBSTITUA_PELA_CHAVE_PUBLICA_veja_docs_RELEASE.md"
    }
  }
}
